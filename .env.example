# Copy to .env and adjust before running `docker compose up`.
DB_PASSWORD=changeme
BURGEE_ADMIN_USERNAME=admin
BURGEE_ADMIN_PASSWORD=changeme
BURGEE_PORT=8080

# Auth method: basic (default), oauth2, or firebase
# BURGEE_AUTH_METHOD=firebase

# Firebase (when BURGEE_AUTH_METHOD=firebase)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your-api-key
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
