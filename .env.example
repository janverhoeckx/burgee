# Copy to .env and adjust before running `docker compose up`.
DB_PASSWORD=changeme
BURGEE_ADMIN_USERNAME=admin
BURGEE_ADMIN_PASSWORD=changeme
BURGEE_PORT=8080

# Auth method: basic (default) or jwt
# BURGEE_AUTH_METHOD=jwt

# JWT / OIDC (when BURGEE_AUTH_METHOD=jwt)
# BURGEE_JWT_ISSUER_URI=
# BURGEE_JWT_CLIENT_ID=
# BURGEE_JWT_SCOPE=openid profile email
# Required for jwt: resource indicator (RFC 8707)
# BURGEE_JWT_RESOURCE_URI=
